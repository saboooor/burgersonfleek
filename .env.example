# Toast POS API Integration Credentials
# Standard API access generated via Toast Web (Integrations > Toast API access > Manage credentials)
TOAST_CLIENT_ID=your_toast_client_id_here
TOAST_CLIENT_SECRET=your_toast_client_secret_here
TOAST_RESTAURANT_EXTERNAL_ID=your_toast_restaurant_external_id_guid_here

# Optional: Override Toast API Base URL (defaults to https://ws-api.toasttab.com)
# TOAST_API_BASE_URL=https://ws-api.toasttab.com

GOOGLE_MAPS_API_KEY=